<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        The uninstall guard is an AccessibilityService. BIND_ACCESSIBILITY_SERVICE
        is declared on the service below as android:permission, which is the platform
        requiring only the user's explicit consent in Settings; it is not a
        uses-permission this module asks for.
    -->
    <application>
        <!--
            No <activity> is declared here on purpose. The challenge is a
            TYPE_ACCESSIBILITY_OVERLAY window added directly by the service, so it
            needs neither a task of its own nor the SYSTEM_ALERT_WINDOW permission an
            Activity-based overlay would require.
        -->
        <service
            android:name=".ShieldAccessibilityGuard"
            android:exported="true"
            android:label="@string/uninstall_guard_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/shield_accessibility_guard" />
        </service>

        <!--
            Fallback notice when the service above is unbound while the user still
            believes the guard is on. The platform gives no callback for an
            accessibility service being switched off, so this reacts to the lifecycle
            events after which that happens.

            exported=false: only this app's own broadcasts can reach it. The system
            still delivers BOOT_COMPLETED and MY_PACKAGE_REPLACED to a non-exported
            receiver, so nothing is lost, and there is no spoofing surface for a
            third-party app to poke at Shield's protection state.
        -->
        <receiver
            android:name=".UninstallGuardFallbackReceiver"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>