<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        The uninstall guard is an AccessibilityService. BIND_ACCESSIBILITY_SERVICE
        is declared on the service below as android:permission, which is the platform
        requiring only the user's explicit consent in Settings; it is not a
        uses-permission this module asks for.
    -->
    <application>
        <!--
            No <activity> is declared here on purpose. The challenge is a
            TYPE_ACCESSIBILITY_OVERLAY window added directly by the service, so it
            needs neither a task of its own nor the SYSTEM_ALERT_WINDOW permission an
            Activity-based overlay would require.
        -->
        <service
            android:name=".ShieldAccessibilityGuard"
            android:exported="true"
            android:label="@string/uninstall_guard_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/shield_accessibility_guard" />
        </service>

        <!--
            Device Administrator fallback, kept ready in case Play rejects the
            Accessibility service permanently. Not surfaced in the UI and never
            requested on the user's behalf: the app only ever hands the user the
            system prompt, from ShieldDeviceAdmin.activationIntent().

            BIND_DEVICE_ADMIN is declared as android:permission, which is the platform
            gating who may talk to this receiver, rather than a uses-permission this
            app requests for itself.
        -->
        <receiver
            android:name=".ShieldDeviceAdmin"
            android:description="@string/device_admin_fallback_description"
            android:exported="true"
            android:label="@string/device_admin_fallback_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/shield_device_admin_policies" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            Fallback notice when the service above is unbound while the user still
            believes the guard is on. The platform gives no callback for an
            accessibility service being switched off, so this reacts to the lifecycle
            events after which that happens.

            exported=false: only this app's own broadcasts can reach it. The system
            still delivers BOOT_COMPLETED and MY_PACKAGE_REPLACED to a non-exported
            receiver, so nothing is lost, and there is no spoofing surface for a
            third-party app to poke at Shield's protection state.
        -->
        <receiver
            android:name=".UninstallGuardFallbackReceiver"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>