<?xml version="1.0" encoding="utf-8"?>
<!--
    Minimal capability set for the uninstall guard.

    android:accessibilityEventTypes is restricted to TYPE_WINDOW_STATE_CHANGED
    because that is the only signal the detector reads. Requesting more would
    widen what Shield can observe for no benefit, and a narrower declaration is
    easier to justify to the user and to Play review.

    packageNames is intentionally left off: the guard must recognise OEM settings
    and package-installer activities, whose package names differ per vendor and
    per Android version, so restricting to a fixed list would miss real devices.

    No canRetrieveWindowContent: the detector reads only the event's package and
    class name and never inspects on-screen content.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/uninstall_guard_service_description" />