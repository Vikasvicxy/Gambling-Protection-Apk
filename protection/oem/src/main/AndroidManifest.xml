<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        NetworkInfoProvider reads the active network to report connection state in
        Diagnostics, so this module declares the permission it depends on. The app
        manifest declares it too; the merger deduplicates them.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
