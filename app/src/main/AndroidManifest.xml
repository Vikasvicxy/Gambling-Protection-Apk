<?xml version="1.0" encoding="utf-8"?>
<!--
    Play Store compliance notes

    Every permission below is declared here or in a library module and is
    justified in the comment attached to it. Play review rejects apps that
    request permissions they do not use, and sensitive permissions need a
    written core-function justification in the listing.

    Permission surface is intentionally minimal: Shield has no analytics, no
    ads, no location, no camera, no contacts, no storage and no account
    permissions. It also sends no telemetry off the device.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Package visibility for per-app DNS exemptions.

        Android 11 (API 30) hides most installed packages by default, so
        getInstalledPackages() returns only a filtered set and
        getPackageInfo() returns NameNotFoundException for anything undeclared.
        Without this, the "bypass protection for selected apps" picker would be
        empty and addDisallowedApplication() would fail for real banking apps.

        Declaring <queries> for the known catalog is deliberate and is the
        Play-safe choice. The alternative is
        android.permission.QUERY_ALL_PACKAGES, which Google Play restricts to a
        short list of accepted uses and which requires a written declaration in
        Play Console; shipping it unapproved risks removal. A <queries> element
        needs no runtime permission and no declaration.

        Trade-off, stated plainly: the picker sees these catalog packages plus
        whatever else the platform volunteers, so it is NOT a complete list of
        installed apps. Users whose bank is absent can still add it by package
        name through the manual-entry field, which is why that field exists.

        Keep this list in sync with ExcludedAppsCatalog.SUGGESTIONS in
        :core:model.
    -->
    <queries>
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="com.phonepe.app" />
        <package android:name="in.org.npci.upiapp" />
        <package android:name="in.amazon.mShop.android.shopping" />
        <package android:name="com.paytm.pktv" />
        <package android:name="com.one.android.paisauser" />
        <package android:name="com.dreamplug.androidapp" />
        <package android:name="com.hdfc.hdfcbank" />
        <package android:name="com.icicibank.mobile" />
        <package android:name="com.axis.mobile" />
        <package android:name="com.sbi.sbiinone" />
        <package android:name="com.kotak.KotakMobileBanking" />
        <package android:name="com.bob.mobilebanking" />
        <package android:name="in.org.npci.bhimpkg" />
        <package android:name="com.yesbank.yescitibank" />
        <package android:name="com.paypal.android.p2pmobile" />
        <package android:name="com.squareup.cash" />
        <package android:name="com.revolut.revolut" />
        <package android:name="com.monzo.monzo.android" />
        <package android:name="com.transferwise.android" />
        <package android:name="com.zelle.android.zelle" />
        <package android:name="com.onedebit.chime" />
        <package android:name="com.microsoft.teams" />
        <package android:name="com.Slack" />
        <package android:name="us.zoom.videomeetings" />
        <package android:name="com.cisco.anyconnect.vpn.android.avf" />
        <package android:name="com.paloaltonetworks.globalprotect" />
        <package android:name="com.cloudflare.onedotonedotonedot" />
        <package android:name="com.nordvpn.android" />
        <package android:name="com.expressvpn.android" />
    </queries>

    <!--
        Required to fetch the signed threat-intelligence feed and the DoH/DoQ
        blocklist. The VPN tunnel itself is not "network access" on the public
        internet, but the sync and blocklist download are, so this cannot be
        dropped.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Read-only network state, used to decide whether the update/blocklist
        sync is currently possible and to report connectivity in Diagnostics.
        No connection is ever opened with it.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Needed to show the local accountability and urge-surfing reminders.
        These are user-facing local notifications only - no notification is a
        push, and nothing is received from a server.

        Note: the ongoing VPN notification is a foreground-service
        notification, which the platform shows regardless of this grant.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Re-arms protection after a reboot so a restart cannot silently leave
        the VPN down. The receiver is guarded by this permission and only ever
        handles BOOT_COMPLETED / LOCKED_BOOT_COMPLETED / MY_PACKAGE_REPLACED.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        The content filter must keep running while the app is backgrounded,
        which is the entire point of a VPN. Required for ShieldVpnService.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
        Android 14+ (API 34) requires the specific type for every foreground
        service. ShieldVpnService declares
        android:foregroundServiceType="connectedDevice", which is the correct
        type for a user-initiated VPN tunnel, and this permission is its
        matching requirement.

        This is deliberately NOT FOREGROUND_SERVICE_SPECIAL_USE: using the
        "special use" type would additionally require completing Play's
        special-use declaration form, and connectedDevice is the accurate type
        here, so no declaration is needed.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!--
        Mandated by the platform to establish and tear down a VPN tunnel
        (android.net.VpnService). Cannot be removed while using VpnService.
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!--
        Sensitive permission, and a common rejection cause. Justification: the
        user has explicitly started a VPN whose core function is filtering
        traffic. Android may kill that tunnel in Doze, which would silently
        stop protection - exactly the failure this app exists to prevent.

        The exemption is only ever requested from a user-initiated action on
        the Diagnostics screen (Settings.ACTION_REQUEST_IGNORE_BATTERY_
        OPTIMIZATIONS); it is never requested at startup or automatically.
        VPN apps are an accepted core-function use case for this permission.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".ShieldApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shield.Starting">

        <!--
            Exported because it is the launcher entry point and therefore must
            be reachable by the system launcher, which is a different UID.
            android:exported is stated explicitly rather than inferred: any
            component with an intent-filter must declare it from API 31, and
            an explicit value lets review see the intent.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Shield.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            androidx.startup content provider. Not app functionality, so it is
            never exported; declaring exported="false" explicitly keeps it out
            of the review surface. The WorkManager initializer entry is removed
            because WorkManager is initialised on demand instead.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            Restarts protection after a reboot or an app update.

            Exported with a permission guard because both broadcasts originate outside the app:
            BOOT_COMPLETED is sent by the system to every app, and MY_PACKAGE_REPLACED is sent by
            the package installer. android.permission.RECEIVE_BOOT_COMPLETED is already declared,
            and reusing it as the guard means no other app can trigger a VPN start by broadcasting
            either action - without this, any installed app could force Shield to bring its tunnel
            up at will.

            The receiver reads the user's on/off preference before starting anything, so a user who
            turned protection off does not get it back on after rebooting.
        -->
        <!--
            Fully qualified rather than relative: the receiver lives in the protection:vpn module
            whose package is not a suffix of the app package, so a relative ".protection.vpn..."
            name would silently resolve to a class that does not exist and lint would (correctly)
            refuse to let the build ship.
        -->
        <receiver
            android:name="dev.gamblock.protection.vpn.ProtectionRestartReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter android:priority="900">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!--
                    HTC's boot broadcast. Undeclared on every other device, so it is simply never
                    delivered there; keeping it costs nothing and covers the devices that need it.
                -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
