<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Shield" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/shield_surface</item>
        <item name="android:statusBarColor">@color/shield_surface</item>
        <item name="android:navigationBarColor">@color/shield_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Shield.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Shield</item>
    </style>
</resources>
