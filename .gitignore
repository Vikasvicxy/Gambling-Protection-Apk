# --- Secrets & keys (never commit) ---
# The release upload key must never reach the repository: losing it means the
# published app can no longer be updated, and committing it leaks that key.
*.jks
*.keystore
*.p12
*.key
keystore.properties
signing.properties
secrets.properties
/release-keys/

# --- Local-only tooling artifacts (never commit) ---
local/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs / caches ---
*.log
hs_err_pid*
.renderscript/

# --- Node (serverless worker) ---
node_modules/
dist-test/

